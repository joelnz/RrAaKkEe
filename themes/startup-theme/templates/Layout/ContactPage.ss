<script src="$themedResourceURL('js/premium.js')"></script>

<section class="interior-hero">
    <h1 class="interior-hero__title anim-title">$Title</h1>
    <p class="interior-hero__desc anim-desc">Got a project in mind?<br>Let's make something together.</p>
</section>

<div class="contact-form reveal">
    <form action="#" method="post">
        <div class="contact-form__field">
            <label class="contact-form__label" for="name">Name</label>
            <input class="contact-form__input" type="text" id="name" name="name" placeholder="Your name">
        </div>
        <div class="contact-form__field">
            <label class="contact-form__label" for="email">Email</label>
            <input class="contact-form__input" type="email" id="email" name="email" placeholder="your@email.com">
        </div>
        <div class="contact-form__field">
            <label class="contact-form__label" for="project">Project</label>
            <input class="contact-form__input" type="text" id="project" name="project" placeholder="Brief description">
        </div>
        <div class="contact-form__field">
            <label class="contact-form__label" for="message">Message</label>
            <textarea class="contact-form__textarea" id="message" name="message" placeholder="Tell me more..."></textarea>
        </div>
        <button type="submit" class="contact-form__submit">Send Message →</button>
    </form>
</div>
