<div id="mobnav">
    <div id="navinner">
        <span class="rr">Rr</span><span class="aa">Aa</span><span class="kk">Kk</span><span class="ee">Ee</span>
    </div>
    <ul class="sections">
        <% loop $Menu(1) %>
            <li><a href="$Link">$MenuTitle</a></li>
        <% end_loop %>
    </ul>
</div>

